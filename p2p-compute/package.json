{
  "name": "p2p-compute",
  "version": "2.0.0",
  "description": "P2P file sharing and computing platform with WebRTC",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "distributed-computing",
    "file-sharing",
    "peer-to-peer"
  ],
  "author": "",
  "license": "MIT",
  "bin": {
    "p2p-compute": "./dist/cli.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "ora": "^7.0.1",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/simple-peer": "^9.11.8",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
